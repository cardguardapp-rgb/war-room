# Local development only. Copy to .env and fill in. Never commit .env.
# Production reads Replit Secrets instead.

# Neon project "warroom-dev". DEV_DATABASE_HOST is the host part of
# DATABASE_URL (between "@" and the next "/", e.g. ep-xxx.region.aws.neon.tech).
# Locally, nothing connects unless the two hosts match.
DATABASE_URL=
DEV_DATABASE_HOST=
# 6–8 digits
APP_PIN=
# At least 32 random characters; changing it logs out every device
SESSION_SECRET=

# Optional
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# e.g. C:\Program Files\LibreOffice\program\soffice.exe (unset = pdf-lib fallback)
SOFFICE_PATH=
CHROMIUM_PATH=
LOG_LEVEL=

# Optional model overrides — leave unset to use the defaults in models.ts.
# AI_MODEL_EXTRACT=
# AI_MODEL_TAILOR=
# AI_MODEL_WRITING=
# AI_MODEL_CHAT=
# AI_MODEL_DISCOVER=
# AI_MODEL_WEBSITE=
# AI_MODEL_SKILL_GROUPING=
# Dev only: the side-by-side comparison model (default claude-sonnet-5-5)
# AI_MODEL_CHAT_COMPARE=
