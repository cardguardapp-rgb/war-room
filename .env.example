# Local development only. Copy to .env and fill in. Never commit .env.
# Production reads Replit Secrets instead.

# Neon project "warroom-dev". DEV_DATABASE_HOST is the host part of
# DATABASE_URL (between "@" and the next "/", e.g. ep-xxx.region.aws.neon.tech).
# Locally, nothing connects unless the two hosts match.
DATABASE_URL=
DEV_DATABASE_HOST=
APP_PIN=
SESSION_SECRET=

# Optional
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# e.g. C:\Program Files\LibreOffice\program\soffice.exe (unset = pdf-lib fallback)
SOFFICE_PATH=
CHROMIUM_PATH=
LOG_LEVEL=
